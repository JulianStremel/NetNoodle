{
  "nftables": [
    {"metainfo": {"version": "1.1.3", "release_name": "Commodore Bullfinch", "json_schema_version": 1}},
    {"chain": {"family": "inet", "table": "netnoodle", "name": "input", "handle": 3, "type": "filter", "hook": "input", "prio": -10, "policy": "accept"}},
    {"rule": {"family": "inet", "table": "netnoodle", "chain": "input", "handle": 4, "expr": [
      {"match": {"op": "==", "left": {"meta": {"key": "iifname"}}, "right": "lo"}},
      {"accept": null}
    ]}},
    {"rule": {"family": "inet", "table": "netnoodle", "chain": "input", "handle": 5, "expr": [
      {"match": {"op": "==", "left": {"payload": {"protocol": "tcp", "field": "dport"}}, "right": "@blocked_tcp"}},
      {"drop": null}
    ]}},
    {"rule": {"family": "inet", "table": "netnoodle", "chain": "input", "handle": 6, "expr": [
      {"match": {"op": "==", "left": {"payload": {"protocol": "udp", "field": "dport"}}, "right": "@blocked_udp"}},
      {"drop": null}
    ]}}
  ]
}
