# systemd unit for nn-agent. Install: see README, "Procedure: install the agent".
# The agent has no capabilities. It finds the programs of systemd services
# and containers without privileges. For other programs, install the
# optional helper (nn-agent-helper.socket); the agent then connects to it.
[Unit]
Description=netnoodle agent (read-only inventory reports)
After=network-online.target nn-agent-helper.socket
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/nn-agent run
User=nn-agent
Group=nn-agent
Restart=on-failure
RestartSec=60

# The agent only reads. Lock everything else down.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/nn-agent

[Install]
WantedBy=multi-user.target
